# MongoDB connection string and database name
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=palatrek

# Public site URL (used for canonical URLs, sitemap and Open Graph)
SITE_URL=http://localhost:3000

# Initial administrator created by `npm run seed` (change after first login)
SEED_ADMIN_EMAIL=admin@palatrek.test
SEED_ADMIN_PASSWORD=change-me-on-first-login

# Reverse proxy hops in front of the app (rate limiting reads the client IP
# your proxy appends, never the client-supplied leftmost X-Forwarded-For)
TRUSTED_PROXY_HOPS=1
# Set to false if your proxy does not overwrite X-Real-IP
TRUST_X_REAL_IP=true

# Production weather (Open-Meteo commercial plan)
# OPEN_METEO_API_KEY=
